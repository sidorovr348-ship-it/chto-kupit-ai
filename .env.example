# AI provider
# Optional China-based multimodal vision fallback (video analyzed through sampled frames).
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
# Required explicit opt-in: upstream free-model providers may have different data policies.
OPENROUTER_FREE_TIER_DATA_USE_ALLOWED=0
ZVENOAI_API_KEY=
# Defaults to a free model router; choose paid models only deliberately.
ZVENOAI_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ZVENOAI_FALLBACK_TEXT_MODEL=cohere/north-mini-code:free
PARALON_API_KEY=
PARALON_BASE_URL=https://paraloncloud.com/v1
PARALON_MODEL=qwen3.8-27b

# Optional web/shopping provider
SERPER_API_KEY=

# Local API port
PORT=3020

# Optional native video analysis through Alibaba Cloud Model Studio (disabled by default).
QWEN_OMNI_ENABLED=0
DASHSCOPE_API_KEY=
QWEN_OMNI_API_KEY=
# Workspace-specific HTTPS base URL, e.g. https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_OMNI_BASE_URL=
QWEN_OMNI_MODEL=qwen3.8-omni-flash

# Optional self-hosted Russian speech recognition (GigaAM v3). Disabled by default.
# Requires a separately deployed, authenticated OpenAI-compatible stt-api service.
GIGAAM_STT_ENABLED=0
GIGAAM_STT_BASE_URL=
GIGAAM_STT_API_KEY=
