# AI provider
# Optional free-tier text fallbacks. Add keys only after reviewing provider data-use terms.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Required explicit opt-in: Google states free-tier content may be used to improve products.
GEMINI_FREE_TIER_DATA_USE_ALLOWED=0
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
# Required explicit opt-in: upstream free-model providers may have different data policies.
OPENROUTER_FREE_TIER_DATA_USE_ALLOWED=0
ZVENOAI_API_KEY=
# Defaults to a free model router; choose paid models only deliberately.
ZVENOAI_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ZVENOAI_FALLBACK_TEXT_MODEL=cohere/north-mini-code:free
PARALON_API_KEY=
PARALON_BASE_URL=https://paraloncloud.com/v1
PARALON_MODEL=qwen3.8-27b

# Optional web/shopping provider
SERPER_API_KEY=

# Local API port
PORT=3020
