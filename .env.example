# AI provider
ZVENOAI_API_KEY=
# Defaults to a free model router; choose paid models only deliberately.
ZVENOAI_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ZVENOAI_FALLBACK_TEXT_MODEL=cohere/north-mini-code:free
PARALON_API_KEY=
PARALON_BASE_URL=https://paraloncloud.com/v1
PARALON_MODEL=qwen3.8-27b

# Optional web/shopping provider
SERPER_API_KEY=

# Local API port
PORT=3020

# Optional FreeLLM local OpenAI-compatible fallback; disabled unless explicitly enabled.
FREELM_ENABLED=0
FREELM_BASE_URL=http://127.0.0.1:4000/v1
FREELM_API_KEY=
FREELM_MODEL=auto
